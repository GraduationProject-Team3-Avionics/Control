<?xml version="1.0"?>
<package format="3">
  <name>system_identification</name>
  <version>0.1.0</version>
  <description>ROS2 tools for UAV system identification (Z-axis step commander and LS estimator).</description>

  <maintainer email="imhyeonwoo21@gmail.com">imhyeonwoo</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime deps for Python nodes installed via ament_cmake -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>px4_msgs</exec_depend>

  <!-- Optional plotting/analysis is handled by the script (no ROS dep) -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
